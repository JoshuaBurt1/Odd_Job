generator client {
  provider        = "prisma-client-js"
  output          = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  OPEN
  ACCEPTED
  AWAITING_EVALUATION
}

enum JobType {
  // Technology
  WEBSITE_BUILDING
  MOBILE_APP_DEVELOPMENT
  DATA_ANNOTATION
  AI_MODEL_TRAINING
  GAME_DEVELOPMENT

  // Agriculture
  CROP_PICKING

  // Sanitation
  TRASH_CLEANUP
  LARGE_ITEM_DISPOSAL

  // Home & Garden
  GRASS_CUTTING
  GARDEN_TENDING
  DECK_FENCE_BUILDING

  // Transportation
  FOOD_DELIVERY
  PACKAGE_DELIVERY
  TAXI_SERVICE
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  password        String         
  name            String
  paymentId       String?        // PayPal/Stripe routing ID for workers
  address         String?
  userLat         Float?
  userLong        Float?
  createdAt       DateTime       @default(now()) 
  
  postedJobs      Job[]          @relation("SeekerJobs")
  acceptedJobs    Job[]          @relation("WorkerJobs")
  
  seekerArchive   CompletedJob[] @relation("SeekerCompleted")
  workerArchive   CompletedJob[] @relation("WorkerCompleted")
}

model Job {
  id          String    @id @default(uuid())
  title       String
  type        JobType
  description String
  price       Float
  status      JobStatus @default(OPEN)  
  startDate   DateTime  @default(now())
  expiryDate  DateTime
  address     String?
  lat         Float?
  lng         Float?
  radius      Float?
  
  seekerId    String
  seeker      User      @relation("SeekerJobs", fields: [seekerId], references: [id])
  
  workerId    String?
  worker      User?     @relation("WorkerJobs", fields: [workerId], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CompletedJob {
  id                String   @id @default(uuid())
  title             String
  type              JobType
  description       String
  price             Float
  
  seekerId          String
  seeker            User     @relation("SeekerCompleted", fields: [seekerId], references: [id])
  
  workerId          String
  worker            User     @relation("WorkerCompleted", fields: [workerId], references: [id])
  
  originalCreatedAt DateTime
  completedAt       DateTime @default(now())
}